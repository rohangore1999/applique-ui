    "externalImports": ["import * as React from \"react\""],
    "setup": "const [notes, setNotes] = React.useState(\"\")",
    "note": "onChange receives the next string value."
  },
  "section": {
    "exports": ["Section", "SectionProps"],
    "jsx": "<Section title=\"Order summary\">\n  <p>Two items selected</p>\n  <p>Total: ₹1,299</p>\n</Section>",
    "note": "Direct public Applique Button children are automatically placed in the section header action area."
  },
  "tabs": {
    "exports": ["Tab", "Tabs", "TabProps", "TabsProps"],
    "jsx": "<Tabs defaultIndex={0} variant=\"line\">\n  <Tabs.Tab title=\"Overview\">Order overview</Tabs.Tab>\n  <Tabs.Tab title=\"History\">Order history</Tabs.Tab>\n</Tabs>"
  },
  "tooltip": {
    "exports": ["Tooltip", "TooltipProps"],
    "jsx": "<Tooltip position=\"up\" renderContent={() => \"Save changes\"}>\n  <button type=\"button\">Save</button>\n</Tooltip>",
    "note": "The public facade keeps the Applique renderContent contract and composes the shadcn tooltip internally."
  }
}
