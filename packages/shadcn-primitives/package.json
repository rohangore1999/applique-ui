{
  "name": "@rohangore1999/shadcn-primitives",
  "version": "0.2.0",
  "main": "dist/shadcn-primitives.cjs.js",
  "module": "dist/shadcn-primitives.esm.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "import": "./dist/shadcn-primitives.esm.js",
      "require": "./dist/shadcn-primitives.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "sync:shadcn": "node scripts/sync-shadcn.js",
    "build:css": "tailwindcss -i src/design.css -o dist/styles.css --minify",
    "build:inject-css": "node scripts/inject-css-import.js",
    "build:registry": "node scripts/generate-registry.js",
    "validate:registry": "node scripts/generate-registry.js --check && node scripts/validate-registry.js",
    "smoke:react18": "node scripts/react18-runtime-smoke.js",
    "smoke:registry": "node scripts/smoke-test-registry.js",
    "build:catalog": "node catalog/build.js",
    "build:pages": "npm run build:registry && npm run validate:registry && npm run build:catalog",
    "serve:catalog": "serve ../../docs -l 4173",
    "build:post": "npm run build:css && npm run build:inject-css && npm run build:registry"
  },
  "author": "Myntra",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": "https://github.com/myntra/applique-ui/tree/release/packages/shadcn-primitives",
  "files": [
    "src/",
    "dist/"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.28.0",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.1",
    "react-hook-form": "7.83.0",
    "react-is": "18.3.1",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "20.0.3",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
